{
  "name": "q86",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Q86 \u2014 personal GMAT Focus quant training platform",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:push": "node -e \"require('fs').mkdirSync('data',{recursive:true})\" && drizzle-kit push",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "backup": "node --experimental-strip-types scripts/backup.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "claim-owner": "node --experimental-strip-types scripts/accounts.ts",
    "dev-account": "node --experimental-strip-types scripts/accounts.ts --dev",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "migrate:multitenant": "node --experimental-strip-types scripts/migrate-multitenant.ts",
    "email:lifecycle": "node --experimental-strip-types scripts/lifecycle-emails.ts",
    "restore": "node --experimental-strip-types scripts/restore.ts",
    "verify-bank": "node --experimental-strip-types scripts/verify-bank.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@libsql/client": "^0.17.4",
    "ai": "^5.0.0",
    "browser-image-compression": "^2.0.2",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.44.0",
    "framer-motion": "^12.0.0",
    "katex": "^0.16.21",
    "lucide-react": "^0.469.0",
    "mathjs": "^14.0.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "stripe": "^22.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ]
  }
}
