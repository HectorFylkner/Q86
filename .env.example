# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Unset = local SQLite file at ./data/q86.db. Set both to point the app,
# `pnpm db:push`, `pnpm seed` and the migration scripts at a hosted libSQL
# (Turso) database instead — required for serverless deployments.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Accounts (M1)
# ---------------------------------------------------------------------------
# Absolute origin used in outbound links (password reset). Falls back to
# VERCEL_URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Google sign-in. Both must be set for the "Fortsätt med Google" button to
# appear at all; without them Q86 runs on email + password only.
# Redirect URI to register: <origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override when the public origin differs from the request origin
# (behind a proxy, or a custom domain in front of a platform URL).
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Billing (M2) — see docs/BILLING.md
# ---------------------------------------------------------------------------
# Unset = the whole deployment runs on the free tier and the checkout
# buttons say so, rather than failing when pressed.
# Use sk_test_… while developing. Nothing in this repository should ever be
# run against sk_live_… without a deliberate decision.
STRIPE_SECRET_KEY=

# From `stripe listen --forward-to localhost:3000/api/billing/webhook`, or
# from the endpoint you create in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=

# Price ids for the two paid plans. Create them in SEK, VAT-inclusive:
#   monthly  249 kr, recurring monthly
#   sprint   599 kr, one-time (three months of access)
# The amounts themselves live in lib/billing/pricing.ts; these only say
# which Stripe object each plan maps to.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_SPRINT=

# Swish is one-time only, so it is offered on the sprint plan and never on
# the monthly subscription. Set to 1 once the Stripe account has it enabled;
# leaving it unset keeps checkout on card + Klarna.
STRIPE_ENABLE_SWISH=

# ---------------------------------------------------------------------------
# AI features
# ---------------------------------------------------------------------------
# Required only for /api/coach (post-mortem), /api/parse-report (score-report
# import), /api/generate (admin-only bank extension) and `pnpm seed --api`.
# The committed 360-question bank loads offline without it.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-4-6. Instance-wide: it is read from
# app_settings, never from a user's preferences.
ANTHROPIC_MODEL=
