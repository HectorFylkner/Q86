# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Unset = local SQLite file at ./data/q86.db. Set both to point the app,
# `pnpm db:push`, `pnpm seed` and the migration scripts at a hosted libSQL
# (Turso) database instead — required for serverless deployments.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Accounts (M1)
# ---------------------------------------------------------------------------
# Absolute origin used in outbound links (password reset). Falls back to
# VERCEL_URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Google sign-in. Both must be set for the "Fortsätt med Google" button to
# appear at all; without them Q86 runs on email + password only.
# Redirect URI to register: <origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override when the public origin differs from the request origin
# (behind a proxy, or a custom domain in front of a platform URL).
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# AI features
# ---------------------------------------------------------------------------
# Required only for /api/coach (post-mortem), /api/parse-report (score-report
# import), /api/generate (admin-only bank extension) and `pnpm seed --api`.
# The committed 360-question bank loads offline without it.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-4-6. Instance-wide: it is read from
# app_settings, never from a user's preferences.
ANTHROPIC_MODEL=
